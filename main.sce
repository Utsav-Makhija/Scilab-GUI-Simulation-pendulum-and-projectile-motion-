function updateProjectileGraph3(handles)

    v0 = get(handles.sliderParam1, "Value");
    angle_deg = get(handles.sliderParam2, "Value");
    g = get(handles.sliderParam3, "Value");

    angle = angle_deg * %pi / 180;
    range = (v0^2 * sin(2 * angle)) / g;
    xMax = max(range, 1);

    if abs(cos(angle)) < 1d-8 then
        x = 0:0.01:xMax;
        y = v0^2/(2*g) - (g*x.^2)/(2*v0^2);
        y(y < 0) = 0;
    else
        x = 0:0.05:max(range, 0.05);
        y = x * tan(angle) - ...
            (g * x.^2) / (2 * v0^2 * cos(angle)^2);
        y(y < 0) = 0;
    end

    frame = handles.graphArea3;
    children = frame.children;
    if size(children, "*") > 0 then
        delete(children);
    end

    ax = newaxes(frame);

    h = findobj("String", "GRAPH 3");
    if size(h, "*") > 0 then
        set(h, "Visible", "off");
    end

    ymax = max(y);
    if ymax <= 0 then
        ymax = 1;
    end

    ax.data_bounds = [0, 0; xMax*1.1, ymax*1.2];

    plot(ax, x, y);

    ax.x_label.text = "Distance (m)";
    ax.y_label.text = "Height (m)";
    ax.title.text = "Projectile Trajectory";
    ax.grid = [1 1];

endfunction
