function pendulumTimerFcn(timerObj, event)

    // Get the main figure
    fig = gcf();

    // Check whether simulation is still running
    running = getappdata(fig, "simulationRunning");

    if ~running then
        stop(timerObj);
        delete(timerObj);
        return;
    end

    // Check pause state
    paused = getappdata(fig, "simulationPaused");

    if paused then
        return;
    end

    // Get stored objects
    rod = getappdata(fig, "pendulumRod");
    bob = getappdata(fig, "pendulumBob");

    // Get parameters
    L = getappdata(fig, "pendulumLength");
    theta0 = getappdata(fig, "pendulumAngle");
    g = getappdata(fig, "pendulumGravity");

    // Current time
    t = getappdata(fig, "simulationTime");

    // Pendulum equation
    theta = theta0 * cos(sqrt(g/L) * t);

    // Bob position
    x = L * sin(theta);
    y = -L * cos(theta);

    // Update rod
    rod.data = [0 0; x y];

    // Update bob
    bob.data = [x y];

    // Update time
    setappdata(fig, "simulationTime", t + 0.03);

    drawnow();

endfunction

function updatePendulumResults(handles)

    // Get current parameters

    L = get(handles.sliderParam1, "Value");

    M = get(handles.sliderParam2, "Value");

    theta0_deg = get(handles.sliderParam3, "Value");

    // Gravity

    g = 9.81;

    // Convert angle to radians

    theta0 = theta0_deg * %pi / 180;

    // Calculate period

    period = 2 * %pi * sqrt(L / g);

    // Calculate frequency

    frequency = 1 / period;

    // Calculate maximum velocity

    maxVelocity = sqrt(2 * g * L * (1 - cos(theta0)));

    // Create table

    results = [
        " "              "Value"                       "Unit";
        "Length"         msprintf("%.2f", L)           "m";
        "Mass"           msprintf("%.2f", M)           "kg";
        "Initial Angle"  msprintf("%.2f", theta0_deg)  "deg";
        "Period"         msprintf("%.2f", period)      "s";
        "Frequency"      msprintf("%.2f", frequency)   "Hz";
        "Max Velocity"   msprintf("%.2f", maxVelocity) "m/s"
    ];

    // Update table

    set(handles.tblResults, "String", results);

endfunction

