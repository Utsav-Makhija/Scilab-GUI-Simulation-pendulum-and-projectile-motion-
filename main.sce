        updatePendulumGraph2(handles);
        updatePendulumGraph3(handles);

    elseif choice == 2 then

        value = get(handles.sliderParam3, "Value");

        set(handles.lblParam3, "String", ...
        msprintf("Gravity (m/s^2): %.2f", value));

        updateProjectileResults(handles);
        updateProjectileGraph1(handles);
        updateProjectileGraph2(handles);
        updateProjectileGraph3(handles);

    end

endfunction

function btnStart_callback(handles)
//Write your callback for  btnStart  here

    choice = get(handles.popupBasic, "Value");
    
    // ==========================================
    // PROJECTILE MOTION
    // ==========================================
    
    if choice == 2 then
    
        runProjectileSimulation(handles);
    
        updateProjectileResults(handles);
    
        updateProjectileGraph1(handles);
    
        updateProjectileGraph2(handles);
    
        updateProjectileGraph3(handles);
    
        return;
    
    end
    
    
    // ==========================================
    // PENDULUM
    // ==========================================
    
    if choice <> 1 then
    
        set(handles.lblStatus, "String", ...
        "Select Pendulum or Projectile Motion");
    
        return;
    
    end

    L = get(handles.sliderParam1, "Value");
    M = get(handles.sliderParam2, "Value");
    theta0_deg = get(handles.sliderParam3, "Value");

    theta0 = theta0_deg * %pi / 180;

    g = 9.81;

    frame = handles.simulationArea;

    children = frame.children;

    if size(children, "*") > 0 then
        delete(children);
    end

    ax = newaxes(frame);

    // Hide GRAPH 1 label
    h = findobj("String", "GRAPH 1");

    if size(h, "*") > 0 then
        set(h, "Visible", "off");
    end

    ax.data_bounds = [-1.2*L, -1.2*L; 1.2*L, 0.2*L];
    ax.axes_visible = ["off","off","off"];

    theta = theta0;

    x = L * sin(theta);
    y = -L * cos(theta);

    rod = plot(ax, [0 x], [0 y]);

    bob = plot(ax, x, y, "o");

    bob.mark_size = 14;

    set(handles.lblStatus, "String", ...
    "Running - Pendulum simulation");

    t = 0;
    dt = 0.03;

    while t <= 10

        theta = theta0 * cos(sqrt(g/L) * t);

        x = L * sin(theta);
        y = -L * cos(theta);

        rod.data = [0 0; x y];

        bob.data = [x y];

        drawnow();

        sleep(30);

        t = t + dt;

    end

    set(handles.lblStatus, "String", ...
    "Simulation complete - Press START to run again");

    // Update graphs
    updatePendulumGraph(handles);
    updatePendulumGraph2(handles);
    updatePendulumGraph3(handles);

endfunction

