function updatePendulumGraph2(handles)

    // ==========================================
    // GET PARAMETERS
    // ==========================================

    L = get(handles.sliderParam1, "Value");

    theta0_deg = get(handles.sliderParam3, "Value");

    theta0 = theta0_deg * %pi / 180;

    g = 9.81;

    // ==========================================
    // TIME
    // ==========================================

    t = 0:0.02:10;

    // ==========================================
    // ANGULAR FREQUENCY
    // ==========================================

    omega = sqrt(g / L);

    // ==========================================
    // VELOCITY
    // ==========================================

    v = -L * theta0 * omega * sin(omega * t);

    // ==========================================
    // CLEAR OLD GRAPH
    // ==========================================

    frame = handles.graphArea2;

    children = frame.children;

    if size(children, "*") > 0 then
        delete(children);
    end

    // ==========================================
    // CREATE AXES
    // ==========================================

    ax = newaxes(frame);

    // Hide GRAPH 2 label
    h = findobj("String", "GRAPH 2");

    if size(h, "*") > 0 then
        set(h, "Visible", "off");
    end

    // ==========================================
    // GRAPH LIMITS
    // ==========================================

    vmax = max(abs(v));

    if vmax == 0 then
        vmax = 1;
    end

    ax.data_bounds = [0, -vmax*1.2;
                      10,  vmax*1.2];

    // ==========================================
    // PLOT
    // ==========================================

    plot(ax, t, v);

    // ==========================================
    // LABELS
    // ==========================================

    ax.x_label.text = "Time (s)";

    ax.y_label.text = "Velocity (m/s)";

    ax.title.text = "Pendulum Velocity vs Time";

    ax.grid = [1 1];

endfunction

function updatePendulumGraph3(handles)

    // ==========================================
    // GET PARAMETERS
    // ==========================================

    L = get(handles.sliderParam1, "Value");

    M = get(handles.sliderParam2, "Value");

    theta0_deg = get(handles.sliderParam3, "Value");

    theta0 = theta0_deg * %pi / 180;

    g = 9.81;

    // ==========================================
    // TIME
    // ==========================================

    t = 0:0.02:10;

    // ==========================================
    // ANGLE
    // ==========================================

    omega = sqrt(g / L);

    theta = theta0 * cos(omega * t);

    // ==========================================
    // VELOCITY
    // ==========================================

    v = -L * theta0 * omega * sin(omega * t);

    // ==========================================
    // KINETIC ENERGY
    // ==========================================

    KE = 0.5 * M .* v.^2;

    // ==========================================
    // POTENTIAL ENERGY
    // ==========================================

    PE = M * g * L .* (1 - cos(theta));

    // ==========================================
    // TOTAL ENERGY
    // ==========================================

    E = KE + PE;

    // ==========================================
    // CLEAR OLD GRAPH
    // ==========================================

    frame = handles.graphArea3;

    children = frame.children;

    if size(children, "*") > 0 then
        delete(children);
    end

    // ==========================================
    // CREATE AXES
    // ==========================================

    ax = newaxes(frame);

    // Hide GRAPH 3 label
    h = findobj("String", "GRAPH 3");

    if size(h, "*") > 0 then
        set(h, "Visible", "off");
    end

    // ==========================================
    // GRAPH LIMITS
    // ==========================================

    Emax = max(E);

    if Emax == 0 then
        Emax = 1;
    end

    ax.data_bounds = [0, 0;
                      10, Emax*1.2];

    // ==========================================
    // PLOT TOTAL ENERGY
    // ==========================================

    plot(ax, t, E);

    // ==========================================
    // LABELS
    // ==========================================

    ax.x_label.text = "Time (s)";

    ax.y_label.text = "Energy (J)";

    ax.title.text = "Mechanical Energy vs Time";

    ax.grid = [1 1];

endfunction

function updateProjectileResults(handles)

    // Get projectile parameters
    v0 = get(handles.sliderParam1, "Value");
    angle_deg = get(handles.sliderParam2, "Value");
    g = get(handles.sliderParam3, "Value");

    // Convert angle to radians
    angle = angle_deg * %pi / 180;

    // Time of flight
    timeFlight = (2 * v0 * sin(angle)) / g;

    // Maximum height
    maxHeight = (v0^2 * sin(angle)^2) / (2 * g);

    // Horizontal range
    range = (v0^2 * sin(2 * angle)) / g;

    // Create results table
    results = [
        "Parameter"          "Value"                       "Unit";
        "Initial Velocity"   msprintf("%.2f", v0)         "m/s";
        "Launch Angle"       msprintf("%.2f", angle_deg)  "deg";
        "Gravity"            msprintf("%.2f", g)         "m/s^2";
        "Time of Flight"     msprintf("%.2f", timeFlight) "s";
        "Maximum Height"     msprintf("%.2f", maxHeight) "m";
        "Range"              msprintf("%.2f", range)     "m"
    ];

    // Display results
    set(handles.tblResults, "String", results);

endfunction

function runProjectileSimulation(handles)

    // ==========================================
    // GET PARAMETERS
    // ==========================================

    v0 = get(handles.sliderParam1, "Value");
    angle_deg = get(handles.sliderParam2, "Value");
    g = get(handles.sliderParam3, "Value");

    angle = angle_deg * %pi / 180;


    // ==========================================
    // CALCULATE MOTION
    // ==========================================

    flightTime = 2 * v0 * sin(angle) / g;

    range = (v0^2 * sin(2 * angle)) / g;

    maxHeight = (v0^2 * sin(angle)^2) / (2 * g);


    // ==========================================
    // PROTECT AGAINST EDGE CASES
    // ==========================================

    if flightTime < 0.1 then
        flightTime = 0.1;
    end

    if range < 1 then
        xLimit = 1;
    else
        xLimit = range;
    end

    if maxHeight < 1 then
        yLimit = 1;
    else
        yLimit = maxHeight;
    end


    // ==========================================
    // CLEAR SIMULATION AREA
    // ==========================================

    frame = handles.simulationArea;

    children = frame.children;

    if size(children, "*") > 0 then
        delete(children);
    end


    // ==========================================
    // CREATE AXES
    // ==========================================

    ax = newaxes(frame);

    ax.data_bounds = [
        0, -0.05*yLimit;
        xLimit*1.10, yLimit*1.20
    ];

    ax.axes_visible = ["off","off","off"];


    // ==========================================
    // GROUND
    // ==========================================

    ground = plot(ax, ...
        [0 xLimit*1.05], ...
        [0 0]);


    // ==========================================
    // PROJECTILE
    // ==========================================

    projectile = plot(ax, ...
        [0 0], ...
        [0 0], ...
        "o");

    projectile.mark_size = 14;


    // ==========================================
    // TRAJECTORY
    // ==========================================

    trajectory = plot(ax, ...
        [0 0], ...
        [0 0]);


    // ==========================================
    // STATUS
    // ==========================================

    set(handles.lblStatus, ...
        "String", ...
        "Running - Projectile simulation");


    drawnow();


    // ==========================================
    // ANIMATION SETTINGS
    // ==========================================

    numberOfFrames = 150;

    dt = flightTime / numberOfFrames;


    // ==========================================
    // TRAJECTORY DATA
    // ==========================================

    trajectoryX = zeros(1, numberOfFrames + 1);

    trajectoryY = zeros(1, numberOfFrames + 1);


    // ==========================================
    // ANIMATION LOOP
    // ==========================================

    for i = 1:numberOfFrames + 1

        t = (i - 1) * dt;


        // Calculate position

        x = v0 * cos(angle) * t;

        y = v0 * sin(angle) * t ...
            - 0.5 * g * t^2;


        // Prevent tiny negative values
        // caused by floating point rounding

        if y < 0 then
            y = 0;
        end


        // Store trajectory

        trajectoryX(i) = x;

        trajectoryY(i) = y;


        // Update projectile

        projectile.data = [x y];


        // Update trail

        trajectory.data = ...
            [trajectoryX(1:i)' trajectoryY(1:i)'];


        // Force graphics refresh

        drawnow();


        // Small delay

        sleep(20);

    end


    // ==========================================
    // EXACT LANDING POSITION
    // ==========================================

    landingX = v0 * cos(angle) * flightTime;

    projectile.data = [landingX 0];


    trajectoryX(numberOfFrames + 1) = landingX;

    trajectoryY(numberOfFrames + 1) = 0;

    trajectory.data = ...
        [trajectoryX' trajectoryY'];


    drawnow();


    // ==========================================
    // COMPLETE
    // ==========================================

    set(handles.lblStatus, ...
        "String", ...
        "Simulation complete - Press START to run again");

endfunction

function updateProjectileGraph1(handles)

    // Get parameters
    v0 = get(handles.sliderParam1, "Value");
    angle_deg = get(handles.sliderParam2, "Value");
    g = get(handles.sliderParam3, "Value");

    angle = angle_deg * %pi / 180;

    // Time of flight
    flightTime = 2 * v0 * sin(angle) / g;

    // Time values
    t = 0:0.02:flightTime;

    // Height
    y = v0 * sin(angle) .* t - 0.5 * g .* t.^2;

    // Graph frame
    frame = handles.graphArea1;

    // Remove previous axes
    children = frame.children;

    if size(children, "*") > 0 then
        delete(children);
    end

    // Create axes
    ax = newaxes(frame);

    // Hide GRAPH 1 label
    h = findobj("String", "GRAPH 1");

    if size(h, "*") > 0 then
        set(h, "Visible", "off");
    end

    // Graph limits
    ymax = max(y);

    if ymax <= 0 then
        ymax = 1;
    end

    ax.data_bounds = [
        0, 0;
        flightTime, ymax*1.2
    ];

    // Plot
    plot(ax, t, y);

    // Labels
    ax.x_label.text = "Time (s)";
    ax.y_label.text = "Height (m)";
    ax.title.text = "Projectile Height vs Time";

    ax.grid = [1 1];

endfunction

function updateProjectileGraph2(handles)

