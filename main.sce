function popupBasic_callback(handles)
//Write your callback for  popupBasic  here

    choice = get(handles.popupBasic, "Value");

    // ==========================================
    // 1. PENDULUM
    // ==========================================
    if choice == 1 then

        set(handles.lblParam1, "String", "Length (m)");
        set(handles.lblParam2, "String", "Mass (kg)");
        set(handles.lblParam3, "String", "Angle (deg)");

        set(handles.sliderParam1, "Min", 0.5);
        set(handles.sliderParam1, "Max", 5);
        set(handles.sliderParam1, "Value", 1);

        set(handles.sliderParam2, "Min", 0.1);
        set(handles.sliderParam2, "Max", 10);
        set(handles.sliderParam2, "Value", 1);

        set(handles.sliderParam3, "Min", 0);
        set(handles.sliderParam3, "Max", 90);
        set(handles.sliderParam3, "Value", 30);

        set(handles.lblStatus, "String", ...
        "Ready - Pendulum simulation");

        set(handles.lblSimulationInfo, "String", ...
        "Simulation: Pendulum");

    // ==========================================
    // 2. PROJECTILE MOTION
    // ==========================================
    elseif choice == 2 then

        set(handles.lblParam1, "String", "Velocity (m/s)");
        set(handles.lblParam2, "String", "Angle (deg)");
        set(handles.lblParam3, "String", "Gravity (m/s^2)");

        set(handles.sliderParam1, "Min", 1);
        set(handles.sliderParam1, "Max", 100);
        set(handles.sliderParam1, "Value", 20);

        set(handles.sliderParam2, "Min", 0);
        set(handles.sliderParam2, "Max", 90);
        set(handles.sliderParam2, "Value", 45);

        set(handles.sliderParam3, "Min", 1);
        set(handles.sliderParam3, "Max", 20);
        set(handles.sliderParam3, "Value", 9.81);

        set(handles.lblStatus, "String", ...
        "Ready - Projectile Motion");

        set(handles.lblSimulationInfo, "String", ...
        "Simulation: Projectile Motion");

    end

endfunction

